# Copy to qa/dashboard/.env (gitignored) and fill in. Read when the dashboard server starts; GET /api/config hands both to the Playground page.
#
# In Google Cloud console (APIs & Services) enable "Maps JavaScript API" and "Routes API", then make a browser API key and
# restrict it to HTTP referrers:
#   http://localhost:4322/*
#   http://127.0.0.1:4322/*
#   http://localhost:4324/*
#   http://127.0.0.1:4324/*
GOOGLE_MAPS_API_KEY=
# A cloud-based Map ID (Map Management) for the styled map; DEMO_MAP_ID works for trying it out.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
